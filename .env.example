# Public Supabase settings. Copy to .env.local for local development.
# Keep DATABASE_URL and SUPABASE_DB_PASSWORD in the host environment only.
# Do not prefix those with NEXT_PUBLIC_, and do not put them in this file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# /test — ETH funds-at-risk scanner (server-only; never NEXT_PUBLIC_*).
# Nothing below is hardcoded anywhere; unset values degrade gracefully.
# ---------------------------------------------------------------------------

# Comma-separated Etherscan API keys for live verified-source ingest.
# Unset → local fixtures / decompile stub only.
ETHERSCAN_API_KEYS=

# Optional Supabase project for /test persist
# (detailed schema: supabase/migrations/*_test_results.sql;
#  Lane A queue: eth-scanner/supabase/migrations/20261027_eth_scanner_queue.sql).
# URL (first wins): ETH_SCANNER_SUPABASE_URL | SUPABASE_URL | NEXT_PUBLIC_SUPABASE_URL
# Key (first wins): SUPABASE_SERVICE_ROLE_KEY | SUPABASE_SECRET_KEY
# Unset → local dry-run store; detailed persist soft-fails and the desk still works.
ETH_SCANNER_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# ETH_SCANNER_DRY_RUN=1

# Optional read-only RPC (eth_getCode / eth_getStorageAt / eth_call only).
# ETH_RPC_URL=

# Python interpreter for `python -m eth_scanner` (Vercel bundles a portable CPython at build).
# ETH_SCANNER_PYTHON=python3
# ETH_SCANNER_WORK_DIR=

# Multi-engine desk (/test → Engines). Binaries are resolved from PATH unless
# overridden; none ship on Vercel, where engines report "missing" and the
# paste-output normalizer is the fallback.
# ETH_SCANNER_SLITHER_BIN=
# ETH_SCANNER_ADERYN_BIN=
# ETH_SCANNER_ACHECKER_BIN=
# ETH_SCANNER_ECHIDNA_BIN=
# ETH_SCANNER_MEDUSA_BIN=
# ETH_SCANNER_ITYFUZZ_BIN=
# ETH_SCANNER_HALMOS_BIN=
# ETH_SCANNER_MYTHRIL_BIN=
# Comma-separated engine ids to force into "stub" (e.g. mythril,ityfuzz).
# ETH_SCANNER_ENGINES_DISABLED=
