# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Fuzzer corpora are an Actions cache, not source.
/fuzz-corpus/

# eth-scanner local artifacts
/eth-scanner/.runtime/
/eth-scanner/work/
/eth-scanner/research/fuzz/out/
/eth-scanner/research/fuzz/cache/
/eth-scanner/research/fuzz/crytic-export/
/eth-scanner/research/fuzz/build/
__pycache__/
