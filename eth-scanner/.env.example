# Ethereum-only invariant scanner — server-side / worker env.
# Copy to .env and fill in. Never commit real keys.

# Comma-separated Etherscan API keys (rotated; default 0.4s spacing).
# Required for live verified-source ingest. Empty → fixtures / decompile stub only.
ETHERSCAN_API_KEYS=
# ETH_SCANNER_ETHERSCAN_INTERVAL=0.4

# Supabase project for the eth_scan_* queue (optional; unset → local dry-run).
# ETH_SCANNER_SUPABASE_URL wins over SUPABASE_URL; NEXT_PUBLIC_SUPABASE_URL is ignored.
ETH_SCANNER_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional read-only eth_getCode / eth_getStorageAt / eth_call (never sends a transaction).
# Used by Lane A ingest and research-stack L0 EIP-1967 + L5 fork checks.
# ETH_RPC_URL=

# Force local work/ JSON store even if a service-role key is set.
# ETH_SCANNER_DRY_RUN=1

# Interpreter for `python -m eth_scanner` (local). Vercel downloads a portable CPython.
# ETH_SCANNER_PYTHON=python3
