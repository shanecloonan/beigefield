# Ethereum-only invariant scanner — server-side / worker env.
# Copy to .env and fill in. Never commit real keys.

# Comma-separated Etherscan API keys. Each key is paced on its own and the
# daily budgets are summed. Empty → fixtures / decompile stub only.
ETHERSCAN_API_KEYS=
# Per key. Defaults match the current free tier. Pace 0.95 stays just under the per-second cap.
# ETH_SCANNER_ETHERSCAN_PER_SECOND=3
# ETH_SCANNER_ETHERSCAN_PER_DAY=100000
# ETH_SCANNER_ETHERSCAN_PACE=0.95
# Optional extra delay. Cannot outrun the per-second cap.
# ETH_SCANNER_ETHERSCAN_INTERVAL=
# Random phase after every list is scanned. Unset follows data/lists.json (default on).
# ETH_SCANNER_RANDOM_SCAN=0

# Supabase project for the eth_scan_* queue (optional; unset → local dry-run).
# ETH_SCANNER_SUPABASE_URL wins over SUPABASE_URL; NEXT_PUBLIC_SUPABASE_URL is ignored.
ETH_SCANNER_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional read-only eth_getCode / eth_getStorageAt / eth_call (never sends a transaction).
# Used by Lane A ingest, live funds floor, and research-stack L0 EIP-1967 + L5 fork checks.
# Public RPC fallbacks are used when unset.
# ETH_RPC_URL=

# Live funds floor (USD). Default 100. Below → drop with 'below funds floor ($X < $Y)'.
# ETH_SCANNER_MIN_FUNDS_USD=100

# Force local work/ JSON store even if a service-role key is set.
# ETH_SCANNER_DRY_RUN=1

# Interpreter for `python -m eth_scanner` (local). Vercel downloads a portable CPython.
# ETH_SCANNER_PYTHON=python3
